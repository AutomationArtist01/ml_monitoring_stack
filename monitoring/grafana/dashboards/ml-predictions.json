   "10s",
   "30s",
   "1m",
   "5m",
   "15m",
   "1h"
  ]
 },
 "templating": {
  "list": [
   {
    "name": "model",
    "label": "Model",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "refresh": 2,
    "query": "label_values(mlgw_requests_total, model)",
    "definition": "label_values(mlgw_requests_total, model)",
    "includeAll": true,
    "multi": false,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
