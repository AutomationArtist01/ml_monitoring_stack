 "panels": [
  {
   "id": 39,
   "type": "row",
   "title": "Prediction distribution",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 41,
   "type": "stat",
   "title": "Mean score (5m)",
   "description": "sum(rate(score_sum))/sum(rate(score_count)); training-time mean \u2248 0.25",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ml:score_mean:5m{model=~\"$model\"}",
     "legendFormat": "mean",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.4
       },
       {
        "color": "red",
        "value": 0.55
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 43,
   "type": "gauge",
   "title": "Positive (churn=1) rate",
   "description": "share of predictions with class 1; training data \u2248 26% churners",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
