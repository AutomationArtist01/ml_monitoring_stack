{
 "uid": "ml-predictions",
 "title": "2 \u00b7 Predictions \u2013 Distribution & Model Behaviour",
 "description": "Is the model still predicting like it did at training time?",
 "tags": [
  "ml",
  "predictions",
  "team4"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
