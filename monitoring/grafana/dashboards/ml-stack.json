  {
   "id": 101,
   "type": "stat",
   "title": "Scrape duration (max)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 5
