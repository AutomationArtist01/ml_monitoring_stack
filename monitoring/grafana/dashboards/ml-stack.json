    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(scrape_duration_seconds)",
     "legendFormat": "s",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 3,
     "thresholds": {
