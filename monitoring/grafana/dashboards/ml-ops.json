 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Golden signals \u2013 traffic \u00b7 latency \u00b7 errors \u00b7 saturation",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Request rate",
   "description": "sum(rate(mlgw_requests_total[1m])) \u2013 requests per second over the last minute",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(mlgw_requests_total{model=~\"$model\"}[1m]))",
     "legendFormat": "req/s",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "p95 latency",
   "description": "histogram_quantile(0.95, \u2026) over 5m",
