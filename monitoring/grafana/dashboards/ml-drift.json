  {
   "id": 79,
   "type": "bargauge",
   "title": "PSI per feature (now)",
   "description": "PSI < 0.10 stable \u00b7 0.10\u20130.25 moderate \u00b7 > 0.25 significant",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sort_desc(drift_psi{model=~\"$model\"})",
     "legendFormat": "{{feature}}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 3,
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true
   }
  },
  {
   "id": 81,
   "type": "timeseries",
   "title": "PSI over time (top features)",
   "description": "watch the lines cross the 0.25 threshold when the drift scenario is switched on",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(8, drift_psi{model=~\"$model\"})",
     "legendFormat": "{{feature}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "thresholdsStyle": {
       "mode": "line+area"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 83,
   "type": "timeseries",
   "title": "KS statistic (numeric features)",
   "description": "Two-sample Kolmogorov\u2013Smirnov D: max distance between the empirical CDFs (0 = identical)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "drift_ks_statistic{model=~\"$model\"}",
     "legendFormat": "{{feature}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 1,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 85,
   "type": "timeseries",
   "title": "KS p-value (log)",
   "description": "p < 0.05 \u2192 reject 'same distribution'. Log scale (values clamped at 1e-6 so p=0 is drawable).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 17,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "clamp_min(drift_ks_pvalue{model=~\"$model\"}, 1e-6)",
     "legendFormat": "{{feature}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "green",
        "value": 0.05
       }
      ]
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "scaleDistribution": {
       "type": "log",
       "log": 10
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 88,
   "type": "timeseries",
   "title": "Numeric feature means: window vs reference",
   "description": "a quick intuition check: are the live means moving away from training-time means?",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 17,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "drift_window_mean{model=~\"$model\"}",
     "legendFormat": "{{feature}} (live)",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "drift_reference_mean{model=~\"$model\"}",
     "legendFormat": "{{feature}} (ref)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*\\(ref\\)"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          6,
          6
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 92,
   "type": "table",
   "title": "Drift table (instant)",
   "description": "Same data as a table \u2013 Prometheus 'graph vs table' point of the demo",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model, feature) (drift_psi{model=~\"$model\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model, feature) (drift_ks_statistic{model=~\"$model\"})",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (model, feature) (drift_ks_pvalue{model=~\"$model\"})",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "PSI"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "decimals",
        "value": 3
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "KS p"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 4
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "KS D"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 3
       }
      ]
     }
    ]
   },
   "options": {
    "sortBy": [
     {
      "displayName": "PSI",
      "desc": true
     }
    ]
   },
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "service": true
      },
      "renameByName": {
       "Value #A": "PSI",
       "Value #B": "KS D",
       "Value #C": "KS p"
      }
     }
    }
   ]
  }
 ]
