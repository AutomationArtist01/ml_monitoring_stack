# Copy to .env and fill in for REAL notifications. Defaults route to the local demo sinks.
# Slack "Incoming Webhook" URL  (Slack app → Incoming Webhooks → Add New Webhook)
SLACK_WEBHOOK_URL=http://webhook-catcher:8091/slack
# SMTP for e-mail alerts (Gmail: smtp.gmail.com:587 + app password; add smtp_auth_* in alertmanager.yml)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=alerts@team4.local
ALERT_EMAIL_TO=oncall@team4.local
