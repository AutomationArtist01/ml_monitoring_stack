# Copy to .env and fill in for REAL notifications. Defaults (when .env is absent) route to the local demo sinks
# (Mailhog http://localhost:8025 and the fake-Slack page http://localhost:8091). .env is git-ignored – never commit it.

# ---- e-mail (Gmail example) -------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your.gmail@gmail.com            # the Gmail account that SENDS the alerts
SMTP_PASSWORD=xxxx xxxx xxxx xxxx         # 16-char Google "App password" (Google Account → Security → 2-Step → App passwords)
SMTP_FROM=your.gmail@gmail.com
ALERT_EMAIL_TO=teammate1@example.com,teammate2@example.com,you@example.com   # comma-separated recipients

# ---- Slack (optional) --------------------------------------------------------
# Slack app → Incoming Webhooks → Add New Webhook → paste the URL. Leave as-is to keep the fake-Slack page.
SLACK_WEBHOOK_URL=http://webhook-catcher:8091/slack
